# Copy this file to .env and adjust values for your local environment.
# Never commit a real .env file.

# --- Server ---
SERVER_PORT=5000
MONGO_URI=mongodb://mongo:27017/aurelia
JWT_SECRET=replace-with-a-long-random-string

# Operational admin account, created on first startup if it does not exist.
# This is not demo data; it is the account used to operate the store.
ADMIN_EMAIL=admin@aurelia.local
ADMIN_PASSWORD=change-this-admin-password

# --- Client ---
CLIENT_PORT=5173
